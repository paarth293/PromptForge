# Environment Configuration for PromptForge
PROMPTFORGE_ENV=development
PORT=8000
HOST=0.0.0.0

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM Providers (Configure at least one or rely on local/mock provider)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Tool Integrations
STRIPE_TEST_SECRET_KEY=

# Security & Storage
DATABASE_URL=sqlite+aiosqlite:///./promptforge.db
TENANT_DEFAULT_ID=tenant-demo
JWT_SECRET=replace-with-secure-random-secret-in-production
DEMO_MODE=true
